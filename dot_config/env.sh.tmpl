# chezmoi source: dot_config/bash/env.sh.tmpl

# XDG standard defaults
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

export USER="${USER:-$(whoami)}"

# Ensure ssh-agent is running on headless or minimal environments
if [ -z "${SSH_AUTH_SOCK:-}" ]; then
  # Check if a saved agent environment file exists and is still valid
  if [ -f "$HOME/.cache/ssh-agent.env" ]; then
    . "$HOME/.cache/ssh-agent.env" >/dev/null
  fi

  # If socket is still missing or dead, start a new agent
  if ! pgrep -u "$USER" ssh-agent >/dev/null || [ ! -S "${SSH_AUTH_SOCK:-}" ]; then
    mkdir -p "$HOME/.cache"
    ssh-agent -s >"$HOME/.cache/ssh-agent.env"
    . "$HOME/.cache/ssh-agent.env" >/dev/null
  fi
fi
