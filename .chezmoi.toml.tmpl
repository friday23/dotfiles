{{- $role := promptStringOnce . "role" "Machine role (desktop/server/minimal)" -}}
{{- $skills := promptBoolOnce . "skills_manager" "Install skills-manager-cli (third-party binary from GitHub)?" false -}}
{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
[data]
  role = {{ $role | quote }}
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  skills_manager = {{ $skills }}
