# .gitignore for a chezmoi source directory (~/.local/share/chezmoi)
# Covers macOS + Linux OS cruft, editor artifacts, and safety nets against
# accidentally committing secrets or local-only overrides.

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── Linux ──────────────────────────────────────────────────────────
.directory
.Trash-*
.nfs*

# ── Editors / IDEs ─────────────────────────────────────────────────
*.swp
*.swo
*~
.*.sw[a-p]
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

# ── Backup / temp files ────────────────────────────────────────────
*.bak
*.orig
*.tmp
*.log

# ── chezmoi-specific safety nets ───────────────────────────────────
# Never let a plaintext age/gpg identity or key end up in the repo,
# even if it's accidentally created or copied inside the source dir.
key.txt
*.age
*.age-identity
*_rsa
*_ed25519
*_ecdsa
*_dsa
!*.pub
id_rsa*
id_ed25519*
!id_rsa.pub
!id_ed25519.pub

# Local-only data overrides that shouldn't be shared across machines
# (adopt this pattern if you use a file like this for secrets/local tweaks)
.chezmoidata.local.*
*.local.yaml
*.local.toml
*.local.json

# chezmoi's own external cache / state, if present in the source tree
.chezmoiexternal.lock
.chezmoi.*.tmp

# ── Misc ────────────────────────────────────────────────────────────
node_modules/
.env
.env.*
